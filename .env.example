# Copie este arquivo para .env e preencha. Na Hostinger, cadastre estas mesmas
# variáveis no painel do app Node.js — nunca commitar credenciais.

# Banco MySQL/MariaDB — guarda usuários, grupos, sessões, painéis e planilhas.
# Local: host remoto do hPanel (Bancos de dados > Remote MySQL), com seu IP liberado.
# Na Hostinger: DB_HOST=localhost
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Conexões simultâneas ao banco (opcional; padrão 5).
# DB_CONEXOES=5

# Site público em / (opcional). 0 desliga e a raiz leva ao login.
# SITE_PUBLICO=1
