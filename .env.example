# Copie este arquivo para .env e preencha para rodar localmente com o R2.
# Em produção (Render), configure estas mesmas variáveis no painel do
# serviço (Environment) em vez de subir um .env — nunca commitar credenciais.

R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
R2_BUCKET=integra2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
