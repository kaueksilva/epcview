# ---------------------------------------------------------------------------
# EPCVIEW
# ---------------------------------------------------------------------------

# Dependências --------------------------------------------------------------
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# Dados da obra -------------------------------------------------------------
# Usuários, painéis e planilhas moram no MySQL (lib/db.js), não no disco nem
# no git. As credenciais do banco ficam no .env (ver "Ambiente e segredos").

# Backups e material de apoio -----------------------------------------------
# Arquivos preservados de versões anteriores e planilhas de exemplo.
backup/

# Sessões -------------------------------------------------------------------
# Tokens de sessão são credenciais vivas: quem tem o token entra sem senha.
# Nunca podem ir para o repositório.
data/sessoes.json
data/*.tmp

# Contatos do site ------------------------------------------------------------
# Nome, e-mail e telefone de quem preencheu o formulário público: dado pessoal,
# não vai para o repositório.
data/contatos.json

# Dockers ----------------------------------------------------------------------
# dockers.json guarda o "Token de acesso" de cada aplicação registrada — uma
# credencial viva, igual às sessões. Os uploads são .tar de container (até
# 2GB) e nunca deveriam sobreviver além do registro (apagados logo depois).
data/dockers.json
data/dockers-uploads/

# Ambiente e segredos -------------------------------------------------------
# Nunca versionar credenciais. Segredos nunca entram no repositório.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Sistema operacional -------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# Editores ------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Temporários e logs --------------------------------------------------------
*.log
*.tmp
*.bak
*.old
tmp/
temp/
.cache/

# Saída de testes -----------------------------------------------------------
perfil-edge*/
*.png.tmp
coverage/
